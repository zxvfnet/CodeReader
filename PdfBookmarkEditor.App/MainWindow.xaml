<Window x:Class="PdfBookmarkEditor.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:PdfBookmarkEditor.Core;assembly=PdfBookmarkEditor.Core"
        xmlns:local="clr-namespace:PdfBookmarkEditor.App"
        Title="PdfBookmarkEditor" Height="600" Width="900"
        Closing="Window_Closing">
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open" Executed="OpenPdf_Executed"/>
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="SaveAs_Executed" CanExecute="RequiresDocument_CanExecute"/>
        <CommandBinding Command="local:MainWindow.ExportJsonCommand" Executed="ExportJson_Executed" CanExecute="RequiresDocument_CanExecute"/>
        <CommandBinding Command="local:MainWindow.ImportJsonCommand" Executed="ImportJson_Executed" CanExecute="RequiresDocument_CanExecute"/>
        <CommandBinding Command="local:MainWindow.AddSiblingCommand" Executed="AddSibling_Executed" CanExecute="RequiresDocument_CanExecute"/>
        <CommandBinding Command="local:MainWindow.AddChildCommand" Executed="AddChild_Executed" CanExecute="RequiresSelection_CanExecute"/>
        <CommandBinding Command="local:MainWindow.DeleteCommand" Executed="Delete_Executed" CanExecute="RequiresSelection_CanExecute"/>
        <CommandBinding Command="local:MainWindow.MoveUpCommand" Executed="MoveUp_Executed" CanExecute="RequiresSelection_CanExecute"/>
        <CommandBinding Command="local:MainWindow.MoveDownCommand" Executed="MoveDown_Executed" CanExecute="RequiresSelection_CanExecute"/>
        <CommandBinding Command="local:MainWindow.OutdentCommand" Executed="Outdent_Executed" CanExecute="RequiresSelection_CanExecute"/>
        <CommandBinding Command="local:MainWindow.IndentCommand" Executed="Indent_Executed" CanExecute="RequiresSelection_CanExecute"/>
        <CommandBinding Command="local:MainWindow.ReloadCommand" Executed="Reload_Executed" CanExecute="RequiresDocument_CanExecute"/>
    </Window.CommandBindings>
    <Window.InputBindings>
        <KeyBinding Command="ApplicationCommands.Open" Key="O" Modifiers="Control"/>
        <KeyBinding Command="ApplicationCommands.SaveAs" Key="S" Modifiers="Control+Shift"/>
        <KeyBinding Command="local:MainWindow.AddSiblingCommand" Key="Insert"/>
        <KeyBinding Command="local:MainWindow.DeleteCommand" Key="Delete"/>
        <KeyBinding Command="local:MainWindow.MoveUpCommand" Key="Up" Modifiers="Alt"/>
        <KeyBinding Command="local:MainWindow.MoveDownCommand" Key="Down" Modifiers="Alt"/>
        <KeyBinding Command="local:MainWindow.OutdentCommand" Key="Left" Modifiers="Alt"/>
        <KeyBinding Command="local:MainWindow.IndentCommand" Key="Right" Modifiers="Alt"/>
    </Window.InputBindings>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="ファイル(_F)">
                <MenuItem Header="開く(_O)..." Command="ApplicationCommands.Open" InputGestureText="Ctrl+O"/>
                <MenuItem Header="名前を付けて保存(_S)..." Command="ApplicationCommands.SaveAs" InputGestureText="Ctrl+Shift+S"/>
                <Separator/>
                <MenuItem Header="JSON書き出し(_E)..." Command="local:MainWindow.ExportJsonCommand"/>
                <MenuItem Header="JSON取り込み(_I)..." Command="local:MainWindow.ImportJsonCommand"/>
                <Separator/>
                <MenuItem Header="終了(_X)" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="編集(_E)">
                <MenuItem Header="しおりを追加(_A)" Command="local:MainWindow.AddSiblingCommand" InputGestureText="Ins"/>
                <MenuItem Header="子しおりを追加(_C)" Command="local:MainWindow.AddChildCommand"/>
                <MenuItem Header="削除(_D)" Command="local:MainWindow.DeleteCommand" InputGestureText="Del"/>
                <Separator/>
                <MenuItem Header="上へ移動(_U)" Command="local:MainWindow.MoveUpCommand" InputGestureText="Alt+↑"/>
                <MenuItem Header="下へ移動(_W)" Command="local:MainWindow.MoveDownCommand" InputGestureText="Alt+↓"/>
                <MenuItem Header="階層を上げる(_L)" Command="local:MainWindow.OutdentCommand" InputGestureText="Alt+←"/>
                <MenuItem Header="階層を下げる(_R)" Command="local:MainWindow.IndentCommand" InputGestureText="Alt+→"/>
                <Separator/>
                <MenuItem Header="編集を破棄して再読込(_Z)" Command="local:MainWindow.ReloadCommand"/>
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Command="local:MainWindow.AddSiblingCommand" Content="追加" ToolTip="しおりを追加 (Ins)"/>
                <Button Command="local:MainWindow.AddChildCommand" Content="子を追加" ToolTip="選択したしおりの子として追加"/>
                <Button Command="local:MainWindow.DeleteCommand" Content="削除" ToolTip="削除 (Del)"/>
                <Separator/>
                <Button Command="local:MainWindow.MoveUpCommand" Content="↑" ToolTip="上へ移動 (Alt+↑)" MinWidth="28"/>
                <Button Command="local:MainWindow.MoveDownCommand" Content="↓" ToolTip="下へ移動 (Alt+↓)" MinWidth="28"/>
                <Button Command="local:MainWindow.OutdentCommand" Content="←" ToolTip="階層を上げる (Alt+←)" MinWidth="28"/>
                <Button Command="local:MainWindow.IndentCommand" Content="→" ToolTip="階層を下げる (Alt+→)" MinWidth="28"/>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusPathText" Text="PDFを開いてください (Ctrl+O)"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <TextBlock x:Name="StatusInfoText"/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="320" MinWidth="240"/>
            </Grid.ColumnDefinitions>

            <TreeView x:Name="BookmarkTreeView" Grid.Column="0" Margin="4"
                      SelectedItemChanged="BookmarkTreeView_SelectedItemChanged">
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem">
                        <Setter Property="IsExpanded" Value="True"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate DataType="{x:Type core:BookmarkNode}"
                                              ItemsSource="{Binding Children}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Bold}" Value="True">
                                                <Setter Property="FontWeight" Value="Bold"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Italic}" Value="True">
                                                <Setter Property="FontStyle" Value="Italic"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Page, StringFormat=' (p.{0})'}"
                                       Foreground="Gray" Margin="2,0,0,0"/>
                            <TextBlock Text=" ⚠ページ未設定" Foreground="DarkOrange" Margin="2,0,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Page}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch"/>

            <GroupBox Grid.Column="2" Header="しおりの編集" Margin="4"
                      x:Name="EditPanel" IsEnabled="False">
                <StackPanel Margin="8">
                    <TextBlock Text="タイトル:"/>
                    <TextBox x:Name="TitleTextBox" Margin="0,2,0,8"
                             Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="ページ:" VerticalAlignment="Center"/>
                        <TextBox x:Name="PageTextBox" Width="60" Margin="6,0,4,0"
                                 VerticalAlignment="Center"
                                 LostFocus="PageTextBox_LostFocus"
                                 KeyDown="PageTextBox_KeyDown"/>
                        <TextBlock x:Name="PageCountText" VerticalAlignment="Center" Foreground="Gray"/>
                    </StackPanel>
                    <TextBlock Text="※空欄にすると「ページ未設定」になります"
                               Foreground="Gray" FontSize="11" Margin="0,-4,0,8"/>

                    <CheckBox Content="太字" IsChecked="{Binding Bold}" Margin="0,0,0,4"/>
                    <CheckBox Content="斜体" IsChecked="{Binding Italic}" Margin="0,0,0,4"/>
                    <CheckBox Content="初期展開(ビューアで開いた時に子を展開)"
                              IsChecked="{Binding Expanded}" Margin="0,0,0,4"/>
                </StackPanel>
            </GroupBox>
        </Grid>
    </DockPanel>
</Window>
